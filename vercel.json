{
  "buildCommand": "npm run vercel-build",
  "installCommand": "npm install && npm --prefix api install",
  "ignoreCommand": "[ \"$VERCEL_GIT_COMMIT_REF\" != \"main\" ]",
  "crons": [
    { "path": "/api/health", "schedule": "*/4 * * * *" }
  ],
  "functions": {
    "src/app/api/queues/session-image/route.ts": {
      "experimentalTriggers": [
        { "type": "queue/v2beta", "topic": "session-image" }
      ]
    }
  }
}
